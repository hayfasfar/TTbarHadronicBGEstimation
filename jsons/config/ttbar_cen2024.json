{
    "NAME": "ttbar",
    "GLOBAL": {
        "FILE": "TTbarAllHad$process.root",
        "FILE_UP": "TTbarAllHad$process_$syst_up.root",
        "FILE_DOWN": "TTbarAllHad$process_$syst_down.root",
        "HIST": "MttvsMt$region",
        "HIST_UP": "MttvsMt$region$systup",
        "HIST_DOWN": "MttvsMt$region$systdown",
        "path": "root://eosuser.cern.ch//eos/user/a/amandal/ttbarhad_root_files/2dAlphabetInputs",
        "SIGNAME": [
            "signalRSGluon4000"
        ]
    },
    "REGIONS": {
        "Cen2024Pass": {
            "PROCESSES": [
                "24_SIGNAME",
                "24_TTbar"
            ],
            "BINNING": "default"
        },
        "Cen2024Fail": {
            "PROCESSES": [
                "24_SIGNAME",
                "24_TTbar"
            ],
            "BINNING": "default"
        }
    },
    "PROCESSES": {
        "data_obs": {
            "SYSTEMATICS": [],
            "SCALE": 1.0,
            "COLOR": "black",
            "TYPE": "DATA",
            "TITLE": "Data",
            "ALIAS": "24_Data",
            "LOC": "path/FILE:HIST"
        },
        "24_SIGNAME": {
            "SYSTEMATICS": [
                "lumi24"
            ],
            "SCALE": 0.1,
            "COLOR": "black",
            "TYPE": "SIGNAL",
            "TITLE": "g_{RS} (2 TeV)",
            "LOC": "path/FILE:HIST"
        },
        "24_TTbar": {
            "SYSTEMATICS": [
                "lumi24",
                "ttbar_xsec"
            ],
            "SCALE": 1.0,
            "COLOR": "red",
            "TYPE": "BKG",
            "TITLE": "t#bar{t}",
            "LOC": "path/FILE:HIST"
        }
    },
    "SYSTEMATICS": {
        "lumi24": {
            "CODE": 0,
            "VAL": 1.02
        },
        "ttbar_xsec": {
            "CODE": 0,
            "VAL": 1.2
        }
    },
    "BINNING": {
        "default": {
            "X": {
                "NAME": "jetmass",
                "TITLE": "m_{t} [GeV]",
                "BINS": [
                    25,
