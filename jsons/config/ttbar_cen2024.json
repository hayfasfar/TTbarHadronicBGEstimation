                "SIGSTART": 105,
                "SIGEND": 210
            },
            "Y": {
                "NAME": "resmass",
                "TITLE": "m_{t#bar{t}} [GeV]",
                "BINS": [
                    800,
                    1100,
                    1300,
                    1500,
                    1700,
                    1900,
                    2100,
                    2300,
                    2500,
                    2700,
                    2900,
                    3100,
                    3300,
                    3500,
                    3700,
                    6500
                ]
            }
        }
    },
    "OPTIONS": {
        "blindedPlots": [],
